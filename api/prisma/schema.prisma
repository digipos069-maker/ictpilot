// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  FREE
  PLUS
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subscription Subscription?
}

model Subscription {
  id                   Int                @id @default(autoincrement())
  userId               Int                @unique
  user                 User               @relation(fields: [userId], references: [id])
  plan                 PlanType           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

enum ImpactLevel {
  HIGH
  MEDIUM
  LOW
}

enum EventStatus {
  UPCOMING
  RELEASED
}

enum NewsCategory {
  FOREX
  CRYPTO
  STOCK
}

model News {
  id             String          @id @default(uuid())
  eventTime      DateTime
  title          String
  country        String
  category       NewsCategory
  impact         ImpactLevel
  effectLevel    Int             // 1, 2, or 3
  affectedPairs  String[]        
  status         EventStatus     @default(UPCOMING)
  source         String?         // URL of source news
  
  aiAnalysis     AiImpactAnalysis?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([title, eventTime, country])
}

model AiImpactAnalysis {
  id                 String     @id @default(uuid())
  eventId            String     @unique
  event              News       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  volatilityWarning  String
  aiSummaryText      String
  
  scenarios          Json       
  heatmapPairs       Json       

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}
